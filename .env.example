# Pour lancer le robot sur ton PC :
# 1. copie ce fichier et renomme la copie en ".env"
# 2. colle tes clés après les signes "=" (sans guillemets, sans espaces)
# Le fichier .env est ignoré par Git : il ne partira jamais sur GitHub.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
