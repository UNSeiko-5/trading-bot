// Robot tendance v2 : la note de tendance du robot, sur n'importe quel graphique TradingView.
// Même calcul que robot/signaux.py (réglages publiés par R. Carver, non ajustés sur les données).
// À utiliser en unité de temps 1 jour (D). Ne passe aucun ordre : c'est seulement pour regarder.
//@version=5
indicator("Robot tendance v2 : note de tendance", shorttitle="Tendance v2", overlay=false, precision=1)

// --- Réglages : identiques à robot/parametres.py (ne pas modifier sans expérience) ---
RAPIDE_1 = 16
LENTE_1 = 64
FACTEUR_1 = 3.75
RAPIDE_2 = 32
LENTE_2 = 128
FACTEUR_2 = 2.65
RAPIDE_3 = 64
LENTE_3 = 256
FACTEUR_3 = 1.87
FENETRE_VOL = 35
JOURS_MIN = 300
NOTE_MAX = 20.0

// Agitation du prix : écart-type exponentiel des variations quotidiennes, en unités de prix
// (comme pandas ewm(span=35).std(), avec la même correction de biais).
variation = nz(ta.change(close))
alpha = 2.0 / (FENETRE_VOL + 1)
moyenne_var = ta.ema(variation, FENETRE_VOL)
moyenne_carres = ta.ema(variation * variation, FENETRE_VOL)
correction = (2.0 - alpha) / (2.0 - 2.0 * alpha)
agitation = math.sqrt(math.max(moyenne_carres - moyenne_var * moyenne_var, 0.0) * correction)

// Note d'un détecteur : écart entre moyenne rapide et moyenne lente, divisé par l'agitation, bornée à ±20
note_detecteur(rapide, lente, facteur) =>
    ecart = ta.ema(close, rapide) - ta.ema(close, lente)
    brute = agitation > 0 ? ecart / agitation * facteur : na
    math.max(-NOTE_MAX, math.min(NOTE_MAX, brute))

n1 = note_detecteur(RAPIDE_1, LENTE_1, FACTEUR_1)
n2 = note_detecteur(RAPIDE_2, LENTE_2, FACTEUR_2)
n3 = note_detecteur(RAPIDE_3, LENTE_3, FACTEUR_3)

// Note combinée : moyenne des 3, ramenée entre 0 (cash) et 20 (tendance très forte)
assez_historique = bar_index >= JOURS_MIN - 1
note = assez_historique ? math.max(0.0, math.min(NOTE_MAX, (n1 + n2 + n3) / 3.0)) : na
haussiers = (n1 > 0 ? 1 : 0) + (n2 > 0 ? 1 : 0) + (n3 > 0 ? 1 : 0)

// --- Affichage ---
hline(0, "Cash", color=color.new(color.gray, 40), linestyle=hline.style_solid)
hline(10, "Tendance normale", color=color.new(color.gray, 60), linestyle=hline.style_dotted)
hline(20, "Tendance très forte", color=color.new(color.gray, 60), linestyle=hline.style_dotted)
plot(note, "Note combinée (0 à 20)", color=note > 0 ? color.new(#22b35e, 0) : color.new(#7f848e, 0), linewidth=2, style=plot.style_area)
plot(n1, "Détecteur rapide 16/64", color=color.new(#86b6ef, 0), linewidth=1)
plot(n2, "Détecteur moyen 32/128", color=color.new(#3987e5, 0), linewidth=1)
plot(n3, "Détecteur lent 64/256", color=color.new(#184f95, 0), linewidth=1)
bgcolor(note > 0 ? color.new(#22b35e, 93) : na, title="Zone acheteur")

// Tableau récapitulatif en haut à droite
var table tableau = table.new(position.top_right, 1, 4, bgcolor=color.new(#161920, 10), border_width=0)
if barstate.islast
    etat = na(note) ? "PAS ASSEZ D'HISTORIQUE" : note > 0 ? "ACHETEUR" : "CASH"
    couleur_etat = na(note) ? color.gray : note > 0 ? #3ccf7a : #b3b6bd
    table.cell(tableau, 0, 0, "Robot tendance v2", text_color=color.white, text_size=size.small)
    table.cell(tableau, 0, 1, "Note : " + (na(note) ? "—" : str.tostring(note, "#.#")) + " / 20", text_color=color.white, text_size=size.normal)
    table.cell(tableau, 0, 2, str.tostring(haussiers) + "/3 détecteurs haussiers", text_color=color.white, text_size=size.small)
    table.cell(tableau, 0, 3, timeframe.isdaily ? etat : "⚠ Passe le graphique en 1 jour (D)", text_color=timeframe.isdaily ? couleur_etat : #fab219, text_size=size.normal)

// Alertes (le nombre d'alertes dépend de ton abonnement TradingView)
alertcondition(note > 0 and nz(note[1]) == 0, "Passage acheteur", "Robot tendance v2 : la note passe au-dessus de 0 sur {{ticker}} (achat)")
alertcondition(note == 0 and nz(note[1]) > 0, "Passage en cash", "Robot tendance v2 : la note retombe à 0 sur {{ticker}} (vente)")
